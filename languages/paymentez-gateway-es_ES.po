msgid "Nuvei Paymentez Gateway for WooCommerce"
msgstr "Pasarela Paymentez para WooCommerce"

msgid "Integrates Paymentez payment gateway (Card Checkout & Link to Pay) into WooCommerce."
msgstr "Integra la pasarela de pago Paymentez (Checkout con tarjeta y Link de Pago) en WooCommerce."

msgid "Paymentez"
msgstr "Paymentez"

msgid "Nuvei Paymentez Gateway requires WooCommerce to be installed and active."
msgstr "Nuvei Paymentez Gateway requiere que WooCommerce esté instalado y activo."

msgid "Paymentez Checkout"
msgstr "Paymentez Checkout"

msgid "Accept card payments via the Paymentez modal checkout."
msgstr "Acepta pagos con tarjeta a través del modal de pago de Paymentez."

msgid "Enable / Disable"
msgstr "Activar / Desactivar"

msgid "Enable Paymentez Checkout"
msgstr "Activar Paymentez Checkout"

msgid "Title"
msgstr "Título"

msgid "Payment method title shown to the customer at checkout."
msgstr "Título del método de pago mostrado al cliente en el proceso de compra."

msgid "Pay with Card"
msgstr "Pagar con Tarjeta"

msgid "Description"
msgstr "Descripción"

msgid "Description shown below the payment method title at checkout."
msgstr "Descripción que se muestra debajo del título del método de pago en el proceso de compra."

msgid "Secure card payment powered by Paymentez."
msgstr "Pago seguro con tarjeta impulsado por Paymentez."

msgid "Environment"
msgstr "Entorno"

msgid "Select the Paymentez environment to use."
msgstr "Selecciona el entorno de Paymentez que deseas utilizar."

msgid "Staging"
msgstr "Pruebas"

msgid "Production"
msgstr "Producción"

msgid "App Code"
msgstr "Código de Aplicación"

msgid "Your Paymentez application code."
msgstr "Tu código de aplicación de Paymentez."

msgid "App Key"
msgstr "Clave de Aplicación"

msgid "Your Paymentez application secret key."
msgstr "Tu clave secreta de aplicación de Paymentez."

msgid "Button Text"
msgstr "Texto del Botón"

msgid "Label displayed on the payment button."
msgstr "Etiqueta que se muestra en el botón de pago."

msgid "Processing payment, please wait..."
msgstr "Procesando el pago, por favor espera…"

msgid "An error occurred while processing your payment. Please try again."
msgstr "Ocurrió un error al procesar tu pago. Por favor inténtalo de nuevo."

msgid "Could not retrieve payment token. Please try again."
msgstr "No se pudo obtener el token de pago. Por favor inténtalo de nuevo."

msgid "Payment cancelled."
msgstr "Pago cancelado."

msgid "Invalid order."
msgstr "Pedido no válido."

msgid "Order not found."
msgstr "Pedido no encontrado."

msgid "Order #%s"
msgstr "Pedido #%s"

msgid "Awaiting Paymentez card payment."
msgstr "A la espera del pago con tarjeta de Paymentez."

msgid "Invalid JSON response from Paymentez."
msgstr "Respuesta JSON inválida de Paymentez."

msgid "Paymentez Link to Pay"
msgstr "Paymentez Link de Pago"

msgid "Redirect customers to a Paymentez-hosted payment page (supports multiple payment methods)."
msgstr "Redirige a los clientes a una página de pago alojada por Paymentez (admite múltiples métodos de pago)."

msgid "Enable Paymentez Link to Pay"
msgstr "Activar Paymentez Link de Pago"

msgid "Other Payment Methods"
msgstr "Otros Métodos de Pago"

msgid "Pay via multiple methods on the Paymentez secure payment page."
msgstr "Paga mediante múltiples métodos en la página de pago seguro de Paymentez."

msgid "Payment error: could not create payment link. Please try again."
msgstr "Error de pago: no se pudo crear el enlace de pago. Por favor inténtalo de nuevo."

msgid "Payment error: invalid response from Paymentez. Please try again."
msgstr "Error de pago: respuesta inválida de Paymentez. Por favor inténtalo de nuevo."

msgid "Awaiting payment via Paymentez Link to Pay."
msgstr "A la espera del pago a través del Link de Pago de Paymentez."

msgid "Invalid payload."
msgstr "Payload no válido."

msgid "Missing required data."
msgstr "Faltan datos requeridos."

msgid "Invalid signature."
msgstr "Firma no válida."

msgid "Paymentez: payment %1$s. Transaction ID: %2$s."
msgstr "Paymentez: pago %1$s. ID de transacción: %2$s."

msgid "Paymentez: received unknown status \"%s\"."
msgstr "Paymentez: se recibió un estado desconocido «%s»."

msgid "Webhook processed successfully."
msgstr "Webhook procesado correctamente."
